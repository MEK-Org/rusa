{
  "name": "rusa",
  "version": "0.1.0",
  "description": "Autonomous coding agent orchestrator",
  "type": "module",
  "bin": {
    "rusa": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "scripts/gh-hint-wrapper.sh",
    "scripts/notify-failure.mjs",
    "scripts/verify-build.mjs"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-assets.mjs && pnpm run build:dashboard-ui",
    "build:dashboard-ui": "node scripts/build-dashboard-ui.mjs",
    "analyze:dashboard-ui": "node scripts/flutter-run.mjs analyze",
    "test:dashboard-ui": "node scripts/flutter-run.mjs test",
    "e2e": "node scripts/e2e.mjs",
    "test": "vitest run",
    "test:full": "pnpm run build:dashboard-ui && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.2.3",
    "concurrently": "^9.2.1",
    "jsdom": "^28.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^5.3.1",
    "@google/genai": "^1.43.0",
    "@inquirer/prompts": "^8.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@thkp-eng/goals-core": "workspace:*",
    "@thkp-eng/goals-types": "workspace:*",
    "better-sqlite3": "^12.6.2",
    "chalk": "^5.4.1",
    "commander": "^14.0.3",
    "dotenv": "^17.2.4",
    "firebase": "^11.4.0",
    "firebase-admin": "^13.7.0",
    "mime": "^4.1.0",
    "open": "^11.0.0",
    "smol-toml": "^1.7.0",
    "yaml": "^2.8.2",
    "zod": "^4.4.3"
  }
}
